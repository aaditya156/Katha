# Application
PROJECT_NAME="Katha Studio"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication (Generate with `openssl rand -hex 32`)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with pgvector)
# For local Docker: postgresql+asyncpg://katha:katha_secret@localhost:5432/katha_studio
# For SQLite test/dev fallback: sqlite+aiosqlite:///./katha_studio.db
DATABASE_URL="postgresql+asyncpg://katha:katha_secret@localhost:5432/katha_studio"
DATABASE_ECHO=false

# Redis (SSE, Task & Cache)
REDIS_URL="redis://localhost:6379/0"

# LLM Providers (At least one required for Phase 2+)
LLM_DEFAULT_PROVIDER="mock" # Options: mock, gemini, groq
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Observability (Phase 5)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# TTS Provider (Phase 3)
TTS_DEFAULT_PROVIDER="mock" # Options: mock, sarvam, elevenlabs
SARVAM_API_KEY=""
ELEVENLABS_API_KEY=""

