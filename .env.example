# ==============================================================================
# Katha Studio — Environment Configuration Specification
# ==============================================================================

# Application & Runtime
PROJECT_NAME="Katha Studio"
ENVIRONMENT="development" # development | staging | production | test
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication (Generate production key: `openssl rand -hex 32`)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 with pgvector extension)
# Docker Compose network host: db:5432
# Local localhost host: localhost:5432
# In-memory test SQLite fallback: sqlite+aiosqlite:///:memory:
POSTGRES_USER=katha
POSTGRES_PASSWORD=katha_secret
POSTGRES_DB=katha_studio
DATABASE_URL="postgresql+asyncpg://katha:katha_secret@localhost:5432/katha_studio"
DATABASE_ECHO=false

# Redis (LangGraph Event Streaming, Synthesis Locks & Audio Metadata Cache)
REDIS_URL="redis://localhost:6379/0"

# LLM Provider Configuration
# Supported options: mock | gemini | groq
LLM_DEFAULT_PROVIDER="mock"
GEMINI_API_KEY=""
GROQ_API_KEY=""

# TTS Provider Configuration
# Supported options: mock | elevenlabs | sarvam
TTS_DEFAULT_PROVIDER="mock"
ELEVENLABS_API_KEY=""
SARVAM_API_KEY=""

# Story Bible & RAG Memory Configuration (Phase 4 Ablation Toggle)
STORY_BIBLE_RETRIEVAL_ENABLED=true

# CI / Production Quality Gate Thresholds (Phase 5)
EVAL_GATE_MIN_PASS_RATE=0.85
EVAL_GATE_MIN_COMPOSITE=3.50
EVAL_GATE_MAX_COST_USD=0.0500
EVAL_GATE_MIN_SAFETY=4.00

# Observability & Tracing (Langfuse / OpenTelemetry)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
